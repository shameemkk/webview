# Copy this file to .env and fill in your values. .env is gitignored.

# ---- Facebook session (to read pages behind the login wall) -----------------
# RECOMMENDED for servers: don't let the server log in (datacenter IPs get blocked
# by captcha/checkpoint). Instead run `python fb_login.py` locally, then paste the
# session here as base64 — no file upload needed:
#   PowerShell:  [Convert]::ToBase64String([IO.File]::ReadAllBytes("fb_state.json"))
#   bash/mac  :  base64 -w0 fb_state.json
# FB_STATE_B64=eyJjb29raWVzIjogW3...   (the long base64 string)
#
# Alternatively, set credentials and let the server log in itself (often blocked
# on servers; account must NOT have 2FA / login approvals):
# FB_EMAIL=your_facebook_email_or_phone
# FB_PASSWORD=your_facebook_password
#
# Where the session file is cached (default: ./fb_state.json):
# FB_STATE_FILE=fb_state.json

# ---- Server (optional, these have sensible defaults) ------------------------
# HOST=0.0.0.0
# PORT=8080
# HEADLESS=true
# PUBLIC_BASE_URL=https://your-domain.example.com
