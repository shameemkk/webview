# Copy this file to .env and fill in your values. .env is gitignored.

# ---- Facebook auto-login (optional) -----------------------------------------
# When both are set, the scraper logs in once and reuses the session so it can
# read pages that are behind Facebook's login wall (e.g. facebook.com/<page>).
# Use an account WITHOUT 2FA / login approvals — automated login can't pass those.
FB_EMAIL=your_facebook_email_or_phone
FB_PASSWORD=your_facebook_password
# Where the reusable session cookies are cached (default: ./fb_state.json)
# FB_STATE_FILE=fb_state.json

# ---- Server (optional, these have sensible defaults) ------------------------
# HOST=0.0.0.0
# PORT=8080
# HEADLESS=true
# PUBLIC_BASE_URL=https://your-domain.example.com
